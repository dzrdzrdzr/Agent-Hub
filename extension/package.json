{
  "name": "agent-hub",
  "displayName": "Agent Hub",
  "description": "Planner \u2194 Executor bridge: a sidebar that lets AI coding agents (Codex, KimiCode) plan and review while delegating heavy code edits to Cline CLI. Submit tasks, watch live output, retry on failure \u2014 all from one panel.",
  "version": "0.2.8",
  "publisher": "agenthub",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Agent Hub",
      "properties": {
        "agentHub.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter for the daemon (needs pyyaml + psutil). Empty = auto-detect from PATH and conda environments."
        },
        "agentHub.daemonRoot": {
          "type": "string",
          "default": "",
          "description": "Optional Agent Hub source/install root containing agentd/agent_hub and config.yaml. Empty uses the bundled daemon, so tasks can target any open workspace."
        },
        "agentHub.port": {
          "type": "number",
          "default": 19876,
          "description": "TCP port for the Agent Hub daemon. Must match the port in config.yaml (default 19876)."
        },
        "agentHub.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the daemon when VS Code opens. Turn off if you prefer to start it manually via 'Agent Hub: Start Daemon' or the status bar."
        }
      }
    },
    "commands": [
      {
        "command": "agent-hub.submitTask",
        "title": "Agent Hub: Delegate Task to Cline",
        "icon": "$(add)"
      },
      {
        "command": "agent-hub.cancelTask",
        "title": "Agent Hub: Cancel Running Task",
        "icon": "$(stop)"
      },
      {
        "command": "agent-hub.refresh",
        "title": "Agent Hub: Refresh Task List",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-hub.startDaemon",
        "title": "Agent Hub: Start Daemon",
        "icon": "$(debug-start)"
      },
      {
        "command": "agent-hub.showLog",
        "title": "Agent Hub: Show Daemon Log",
        "icon": "$(output)"
      },
      {
        "command": "agent-hub.openTask",
        "title": "Agent Hub: Watch Task Output",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agent-hub.openTaskLog",
        "title": "Agent Hub: Open Raw Output Log",
        "icon": "$(file-text)"
      },
      {
        "command": "agent-hub.startGoal",
        "title": "Agent Hub: Start Goal"
      },
      {
        "command": "agent-hub.refreshGoals",
        "title": "Agent Hub: Refresh Goals"
      },
      {
        "command": "agent-hub.openGoalDetail",
        "title": "Agent Hub: Open Goal Details",
        "icon": "$(preview)"
      },
      {
        "command": "agent-hub.cancelGoal",
        "title": "Agent Hub: Cancel Goal",
        "icon": "$(stop)"
      },
      {
        "command": "agent-hub.deleteGoal",
        "title": "Agent Hub: Delete Goal",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-hub.submitTask",
          "when": "view == agent-hub.tasks",
          "group": "navigation"
        },
        {
          "command": "agent-hub.refresh",
          "when": "view == agent-hub.tasks",
          "group": "navigation"
        },
        {
          "command": "agent-hub.startGoal",
          "when": "view == agent-hub.goals",
          "group": "navigation"
        },
        {
          "command": "agent-hub.refreshGoals",
          "when": "view == agent-hub.goals",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agent-hub.openTask",
          "when": "view == agent-hub.tasks",
          "group": "inline"
        },
        {
          "command": "agent-hub.openTaskLog",
          "when": "view == agent-hub.tasks"
        },
        {
          "command": "agent-hub.cancelTask",
          "when": "view == agent-hub.tasks"
        },
        {
          "command": "agent-hub.openGoalDetail",
          "when": "view == agent-hub.goals && (viewItem == goalActive || viewItem == goalTerminal)",
          "group": "inline"
        },
        {
          "command": "agent-hub.cancelGoal",
          "when": "view == agent-hub.goals && viewItem == goalActive"
        },
        {
          "command": "agent-hub.deleteGoal",
          "when": "view == agent-hub.goals && viewItem == goalTerminal"
        }
      ]
    },
    "views": {
      "agent-hub": [
        {
          "id": "agent-hub.goals",
          "name": "Goals"
        },
        {
          "id": "agent-hub.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-hub",
          "title": "Agent Hub",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepare-daemon": "node scripts/prepare-daemon.js",
    "package": "npm run prepare-daemon && vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.0.0"
  }
}
