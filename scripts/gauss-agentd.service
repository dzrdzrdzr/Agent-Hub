[Unit]
Description=GAUSS Agent Control Center Daemon
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/share/gauss-agent/.venv/bin/python -m gauss_agentd.main
WorkingDirectory=%h/gauss-agent
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=GAUSS_AGENT_HOME=%h/.local/share/gauss-agent

[Install]
WantedBy=default.target
